%TMPL:DEF{"breadcrumbs::tail"}%%TMPL:P{"sep"}%<a href="%SCRIPTURLPATH{"view" topic="%BASEWEB%.%BASETOPIC%" template="qmhistory" rev="%URLPARAM{"rev"}%"}%">%MAKETEXT{"Workflow History"}%</a>%TMPL:END%
%TMPL:DEF{"heading"}%%MAKETEXT{"Workflow History"}%%TMPL:END%

%TMPL:DEF{"content"}%<h1>%TMPL:P{"heading"}%</h1>
%TMPL:P{"qmtable"}%
%TMPL:P{"qmtable::navi"}%
%TMPL:END%

%TMPL:DEF{"qmtable"}%<div class="natQMHistoryTable" data-limit='%URLPARAM{"limit" default="10"}%' data-skip='%URLPARAM{"skip" default="0"}%'>
%QMHISTORY{
  topic="%WEB%.%TOPIC%"
  title="<!-- -->"
  reverse="on"
  _limit="%URLPARAM{"limit" default="10"}%"
  %IF{"$'URLPARAM{from}'!=''"
    then="from_date=\"%DATETIME{"%URLPARAM{"from"}%" format="$epoch"}%\""
  }%
}%</div>%TMPL:END%

%TMPL:DEF{"topicactions"}%<div class='natTopicActions'>%USERACTIONS{format="$action(close)"}%</div>%TMPL:END%

%TMPL:DEF{"DIS_qmtable::navi"}%<div class="clearfix">
%CALCULATE{"
  $SET(prevSkip,$EVAL(%URLPARAM{"skip" default="0"}%-%URLPARAM{"limit" default="10"}%))
  $IF($GET(prevSkip < 0,$SET(prevSkip,0)))
  $SET(nextSkip,$EVAL(%URLPARAM{"skip" default="0"}%+%URLPARAM{"limit" default="10"}%))
  $IF($GET(nextSkip > %NATMAXREV%,$SET(nextSkip,%NATMAXREV%)))
"}%<!-- -->
<a href='#' class='natHistoryNavi %CALCULATE{"$IF($GET(prevSkip)==0,natDisabledTopicAction)"}%' data-skip="0">
  %TMPL:P{"qm::control::start::icon"}%
</a>
<a href='#' class='natHistoryNavi %CALCULATE{"$IF($GET(prevSkip)==0,natDisabledTopicAction)"}%' data-skip="%CALCULATE{"$GET(prevSkip)"}%">
  %TMPL:P{"qm::control::prev::icon"}%
</a>
<a href='#' class='natHistoryNavi' data-skip="%CALCULATE{"$GET(nextSkip)"}%" >
  %TMPL:P{"qm::control::next::icon"}%
</a>
<a href='#' class='natHistoryNavi %CALCULATE{"$IF($GET(nextSkip)>%NATMAXREV%,natDisabledTopicAction)"}%' data-skip="%NATMAXREV%">
  %TMPL:P{"qm::control::end::icon"}%
</a>
</div>%TMPL:END%

%TMPL:DEF{"dialog"}%<div class="jqUIDialog foswikiFormSteps" data-modal="true" data-draggable="true" data-width="auto" title="%TMPL:P{"heading"}%">
%TMPL:P{"qmtable"}%
%TMPL:P{"qmtable::navi"}%
<a class="jqUIDialogButton jqUIDialogDestroy" data-icon="ui-icon-cancel">%MAKETEXT{"Close"}%</a>
</div>%TMPL:END%
