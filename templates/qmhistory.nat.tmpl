%TMPL:DEF{"qm::control::prev::disabled::icon"}%%TMPL:P{"icon::prev"}%%TMPL:END%
%TMPL:DEF{"qm::control::next::icon"}%%TMPL:P{"icon::next"}%%TMPL:END%
%TMPL:DEF{"qm::control::next::disabled::icon"}%%TMPL:P{"icon::next"}%%TMPL:END%
%TMPL:DEF{"qm::control::end::icon"}%%TMPL:P{"icon::last"}%%TMPL:END%
%TMPL:DEF{"qm::control::end::disabled::icon"}%%TMPL:P{"icon::last"}%%TMPL:END%
%TMPL:DEF{"qm::control::quit"}%%USERACTIONS{"$action(close)"}%%TMPL:END%

%TMPL:DEF{"bodyclass"}%natWorkflowBody%TMPL:END%
%TMPL:DEF{"form"}%%TMPL:END%
%TMPL:DEF{"revinfo"}%%TMPL:END%
