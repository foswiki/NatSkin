%TMPL:DEF{"dialog"}%%IF{"'%WEB%'='%TRASHWEB%' and context TrashPluginEnabled"
  then="$percntTMPL:P{\"dialog::delete\"}$percnt"
  else="$percntTMPL:P{\"dialog::trash\"}$percnt"
}%%TMPL:END%

%TMPL:DEF{"dialog::trash"}%<div class="jqUIDialog foswikiFormSteps" data-modal="true" data-width="450" data-draggable="true" data-destroy-on-close="true" title="%MAKETEXT{"Delete Topic"}%" id="deleteTopicDialog">
%TMPL:P{"dialog::trash::content"}%%{}%
</div>%TMPL:END%

%TMPL:DEF{"dialog::trash::content"}%<form name="rename" action="%SCRIPTURLPATH{"rename"}%/%WEB%/%TOPIC%" method="post">
  <input type="hidden" name="nonwikiword" value="on" />
  <input type="hidden" name="oldtopic" value="%TOPIC%" />
  <input type="hidden" name="newtopic" value="%TOPIC%%GMTIME{"$epoch"}%" />
  <input type="hidden" name="newweb" value="%TRASHWEB%"  />
  <input type="hidden" name="redirectto" value="%WEB%.%HOMETOPIC%"  />
  %TMPL:P{"thumbnail"}%%{}%
  %MAKETEXT{"Are you sure that you want to delete [_1]?" args="<b>%GETTOPICTITLE{"%WEB%.%TOPIC%" encode="entity"}%</b>"}%
  <a class="jqUIDialogButton jqUIDialogSubmit" data-icon="ui-icon-trash">%MAKETEXT{"Yes, delete"}%</a> 
  <a class="jqUIDialogButton jqUIDialogClose" data-icon="ui-icon-cancel">%MAKETEXT{"No, thanks"}%</a> 
</form>%TMPL:END%

%TMPL:DEF{"dialog::delete"}%<div class="jqUIDialog foswikiFormSteps" data-modal="true" data-width="450" data-draggable="true" data-destroy-on-close="true" title="%MAKETEXT{"Finally Delete Topic"}%" id="deleteTopicDialog">
%TMPL:P{"dialog::delete::content"}%%{}%
</div>%TMPL:END%

%TMPL:DEF{"dialog::delete::content"}%<form name="rename" action="%SCRIPTURLPATH{"rest"}%/TrashPlugin/cleanUp" method="post">
  <input type="hidden" name="expire" value="0" />
  <input type="hidden" name="mode" value="topic" />
  <input type="hidden" name="web" value="%WEB%" />
  <input type="hidden" name="topic" value="%WEB%.%TOPIC%" />
  <input type="hidden" name="includetopic" value="^%TOPIC%$" />
  <input type="hidden" name="redirectto" value="%WEB%.%HOMETOPIC%"  />
  %TMPL:P{"thumbnail"}%%{}%
  %MAKETEXT{"Are you sure that you want to finally delete [_1]?" args="<b>%GETTOPICTITLE{"%WEB%.%TOPIC%" encode="entity"}%</b>"}%
  <div class='foswikiWarningMessage' style='margin:var(--margin) 0 0'>%MAKETEXT{"Note that this action cannot be undone."}%</div>
  <a class="jqUIDialogButton jqUIDialogSubmit" data-icon="ui-icon-trash">%MAKETEXT{"Yes, delete"}%</a> 
  <a class="jqUIDialogButton jqUIDialogClose" data-icon="ui-icon-cancel">%MAKETEXT{"No, thanks"}%</a> 
</form>%TMPL:END%

%TMPL:DEF{"thumbnail"}%%IF{"istopic 'Applications.RenderTopicThumbnail'"
  then="$percntDBCALL{\"%WEB%.%TOPIC%->Applications.RenderTopicThumbnail\"
	  TOOLTIP=\"off\"
	  TYPE=\"plain\"
	  CROP=\"northwest\"
	  SIZE=\"96x96>^\"
	}$percnt"
}%%TMPL:END%

